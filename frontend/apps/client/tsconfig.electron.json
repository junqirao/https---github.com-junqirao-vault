{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "sourceMap": false,
    "declaration": false,
    "isolatedModules": false
  },
  "include": ["electron/**/*.ts"]
}
